{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "P2P Ledger",
  "version": "0.5.0",
  "identifier": "io.github.marcossglr.p2pledger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "P2P Ledger — Terminal de Conciliación P2P",
        "label": "main",
        "create": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "marcossglr",
    "copyright": "Copyright © 2026 marcossglr. Licenciado bajo GPL-3.0.",
    "category": "Finance",
    "homepage": "https://github.com/marcossglr/P2P-ledger",
    "license": "GPL-3.0-only",
    "shortDescription": "Terminal de conciliación para Binance P2P y bancos",
    "longDescription": "P2P Ledger es un terminal financiero de escritorio para conciliar operaciones de Binance P2P con movimientos bancarios, controlar inventario por banco, calcular costo promedio ponderado y analizar el mercado P2P en tiempo real.",
    "targets": [
      "rpm",
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "externalBin": [
      "binaries/p2p-ledger-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "release": "1",
        "epoch": 0
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwQUNFRDIyMUI3OUI2NEIKUldSTHRua2JJdTJzQUlRdWF4clM1bEIwR2ZXVnBCLytINUJTUUZXU2szS3F1K3V2MEZqZ1ZYTGgK",
      "endpoints": [
        "https://github.com/marcossglr/P2P-ledger/releases/latest/download/latest.json"
      ]
    }
  }
}
