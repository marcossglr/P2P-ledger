{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "P2P Ledger",
  "version": "0.3.2",
  "identifier": "com.p2pledger.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "P2P Ledger — Terminal Financiero",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["rpm", "deb", "appimage", "nsis", "msi"],
    "externalBin": [
      "binaries/p2p-ledger-backend"
    ],
    "icon": [
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "release": "1",
        "epoch": 0
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "RWRLtnkbIu2sAIQuaxrS5lB0GfWVpB/+H5BSQFWSk3Kqu+uv0FjgVXLh",
      "endpoints": [
        "https://github.com/marcossglr/P2P-ledger/releases/latest/download/latest.json"
      ]
    }
  }
}
