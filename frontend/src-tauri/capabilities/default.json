{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacidades por defecto de la ventana principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "updater:default",
    "process:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:*" },
        { "url": "http://localhost:*" },
        { "url": "https://api.github.com/*" },
        { "url": "https://p2p.binance.com/*" }
      ]
    }
  ]
}
